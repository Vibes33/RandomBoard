# ─── Copie ce fichier vers .env et remplis les valeurs ───
# IMPORTANT : .env ne doit JAMAIS être committé (voir .gitignore)

# Django
DJANGO_SECRET_KEY=change-me-genere-une-vraie-cle
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Mise en ligne (domaine public + HTTPS) ───
# En prod : DJANGO_DEBUG=0, ajouter le domaine à ALLOWED_HOSTS (sans schéma) ET
# à CSRF_TRUSTED_ORIGINS (avec https://). Activer BEHIND_PROXY si un reverse
# proxy (nginx/Caddy/Traefik) termine le TLS devant le conteneur.
#   DJANGO_DEBUG=0
#   DJANGO_ALLOWED_HOSTS=ldb.gitgud.fyi
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://ldb.gitgud.fyi
#   DJANGO_BEHIND_PROXY=1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_PROXY=0

# Base de données (doit matcher le service db dans docker-compose)
POSTGRES_DB=chaos42
POSTGRES_USER=chaos
POSTGRES_PASSWORD=chaos_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Superuser créé automatiquement au premier démarrage (dev only)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ─── API 42 ───
FT_API_BASE=https://api.intra.42.fr

# Pool de clés qui se relaient (jusqu'à 20). Crée autant d'apps OAuth sur
# https://profile.intra.42.fr/oauth/applications et numérote-les :
FT_API_UID_1=
FT_API_SECRET_1=
FT_API_UID_2=
FT_API_SECRET_2=
# … jusqu'à FT_API_UID_10 / FT_API_SECRET_10
# (alternative 1 ligne : FT_API_KEYS=uid1:secret1,uid2:secret2,…)

# Cible : piscine du Havre, session Juillet 2026
FT_CAMPUS_ID=                 # ID du campus Le Havre — lance `ft_campuses` pour le trouver
FT_POOL_YEAR=2026
FT_POOL_MONTH=july            # nom anglais en minuscules

# ─── Google Sheet des trolls (Apps Script) ───
TROLL_SHEET_URL=
TROLL_SHEET_PASSWORD=
